# ========== Telegram ==========
# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# ========== QQ Bot（OneBot V11 直连）==========
# NapCat WebSocket 端点（Bot 订阅事件 + 发送消息）
QQ_WS_URL=ws://localhost:3001
# access token（在 NapCat WebUI 设置，未设置则留空）
QQ_ACCESS_TOKEN=

# ========== VPS 节点 ==========
# VPS 公网 IP（填入后在 config.yaml 中用 ${VPS1_HOST} 引用）
VPS1_HOST=
VPS2_HOST=

# VPS Agent Bearer Token（与 VPS 上 agent 的 .env 保持一致）
VPS1_AGENT_TOKEN=
VPS2_AGENT_TOKEN=

# ========== 代理（树莓派访问 Telegram 用）==========
# 若本机可直连 Telegram 则留空
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
