# ========== Telegram ==========
# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# ========== QQ Bot（OneBot V11 直连）==========
# 支持后端：NapCat / LLOneBot / Lagrange / go-cqhttp
#
# WebSocket 端点（Bot 订阅事件用）
QQ_WS_URL=ws://localhost:3001
# HTTP 端点（Bot 发送消息用）
QQ_HTTP_URL=http://localhost:3000
# access token（在 OneBot 后端配置，可留空）
QQ_ACCESS_TOKEN=

# ========== VPS Agent Token ==========
# 在每台 VPS 的 Agent .env 中设置相同的 token（自定义随机字符串）
VPS1_AGENT_TOKEN=
VPS2_AGENT_TOKEN=

# ========== AI API（可选，仅 ai 命令使用）==========
ANTHROPIC_API_KEY=
